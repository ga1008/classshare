{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LanShare 存档描述 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "series", "saveVersion", "privateFields", "milestones"],
  "properties": {
    "formatVersion": { "const": 1 },
    "series": { "$ref": "#/$defs/name" },
    "saveVersion": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "privateFields": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "default"],
            "properties": {
              "type": { "const": "boolean" },
              "default": { "type": "boolean" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "min", "max", "default"],
            "properties": {
              "type": { "const": "integer" },
              "min": { "$ref": "#/$defs/int" },
              "max": { "$ref": "#/$defs/int" },
              "default": { "$ref": "#/$defs/int" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "values", "default"],
            "properties": {
              "type": { "const": "enum" },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/name" }
              },
              "default": { "$ref": "#/$defs/name" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "schema", "default"],
            "properties": {
              "type": { "const": "document" },
              "schema": { "$ref": "#/$defs/shape" },
              "default": {}
            }
          }
        ]
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "resumeState"],
        "properties": {
          "id": { "$ref": "#/$defs/name" },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "resumeState": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/name" }]
          }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$" },
    "int": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "properties", "required", "additionalProperties"],
          "properties": {
            "type": { "const": "object" },
            "additionalProperties": { "const": false },
            "properties": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": { "$ref": "#/$defs/name" },
              "additionalProperties": { "$ref": "#/$defs/shape" }
            },
            "required": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 64,
              "items": { "$ref": "#/$defs/name" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items", "maxItems"],
          "properties": {
            "type": { "const": "array" },
            "maxItems": { "type": "integer", "minimum": 0, "maximum": 4096 },
            "items": { "$ref": "#/$defs/shape" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minimum", "maximum"],
          "properties": {
            "type": { "const": "integer" },
            "minimum": { "$ref": "#/$defs/int" },
            "maximum": { "$ref": "#/$defs/int" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "maxLength"],
          "properties": {
            "type": { "const": "string" },
            "minLength": { "type": "integer", "minimum": 0, "maximum": 256 },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 256 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "values"],
          "properties": {
            "type": { "const": "enum" },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/name" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "boolean" } }
        }
      ]
    }
  }
}
