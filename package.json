{
  "scripts": {
    "build": "npm run build:css && npm run build:frontend",
    "build:css": "tailwindcss -c tailwind.config.js -i ./static/css/ui-system.src.css -o ./static/css/tailwind-app.css --minify",
    "build:frontend": "vite build",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173",
    "inventory:frontend": "python tools/frontend_migration_inventory.py",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:p03": "playwright test tests/e2e/specs --project=chromium",
    "test:e2e:p12": "playwright test tests/e2e/specs/message-center.spec.ts tests/e2e/specs/classroom.spec.ts tests/e2e/specs/materials.spec.ts --project=chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  }
