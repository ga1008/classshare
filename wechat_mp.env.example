# 微信小程序接入所需资源 — 复制为 wechat_mp.env 填写（*.env 已被 gitignore，不会入库）
# 填好后告诉我"资源已就绪"，我按 docs/miniprogram/DESIGN.md 的 P1 开工。

# ── 必填：小程序身份（mp.weixin.qq.com → 开发 → 开发管理 → 开发设置）──
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=

# ── 必填：生产域名（必须已 ICP 备案，小程序不接受 IP）──
# 例：lanshare.example.cn ；填好后我来配 nginx + Let's Encrypt 证书
LANSHARE_PUBLIC_DOMAIN=
# 备案状态说明（已备案 / 备案中预计日期 / 未开始）
LANSHARE_DOMAIN_ICP_STATUS=

# ── 强烈建议：miniprogram-ci 代码上传密钥（开发设置 → 小程序代码上传 → 生成密钥并下载）──
# 把下载的 private.<appid>.key 文件放到本仓库根目录，文件名填在这里（*.key 建议同样不入库）。
# 同页的"IP 白名单"请暂时关闭，或告诉我需加白的出口 IP。
WECHAT_MP_CI_PRIVATE_KEY_FILE=

# ── 选填 ──
# 体验版体验者微信号（逗号分隔，需在后台"成员管理"添加；用于真机验收）
WECHAT_MP_TESTERS=
# 小程序主体类型（个人 / 企业 / 学校组织），影响类目与上架路径
WECHAT_MP_SUBJECT_TYPE=
