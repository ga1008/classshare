# Substitute your dedicated hostname and matching certificate files before loading this vhost.
server {
    listen 80;
    server_name games.example.edu;
    access_log /var/log/nginx/access.log lq_timing;
    error_log /dev/null crit;
    return 404;
}

server {
    listen 443 ssl;
    server_name games.example.edu;
    ssl_certificate /etc/nginx/game-tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/game-tls/privkey.pem;
    access_log /var/log/nginx/access.log lq_timing;
    # Nginx error messages may include the URL; discard path-bearing diagnostics for this vhost.
    error_log /dev/null crit;
    location /l/ {
        limit_except GET { deny all; }
        resolver 127.0.0.11 valid=10s ipv6=off;
        resolver_timeout 2s;
        set $game_content_upstream http://game-content:8014;
        proxy_pass $game_content_upstream;
        proxy_set_header Host $lq_proxy_host;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
        proxy_buffering off;
        proxy_cache off;
    }
    location / { return 404; }
}

