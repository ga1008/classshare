# Built only when dependency inputs change; application builds never install packages.
FROM python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ARG DEPENDENCY_FINGERPRINT
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
LABEL io.lanshare.dependencies.kind="runtime" \
      io.lanshare.dependencies.fingerprint="${DEPENDENCY_FINGERPRINT}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    TZ=Asia/Shanghai \
    APP_TIMEZONE=Asia/Shanghai \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        antiword build-essential ca-certificates fonts-arphic-uming \
        fonts-dejavu-core fonts-liberation git libarchive-tools \
        libreoffice-calc libreoffice-impress libreoffice-writer poppler-utils tzdata \
    && ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime \
    && echo "${TZ}" > /etc/timezone \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements.lock.txt requirements-docker.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt -i "${PIP_INDEX_URL}" \
    && python -m pip check

COPY deployment/docker/verify-dependencies.sh /usr/local/bin/lanshare-verify-dependencies
COPY dependency-inputs.sha256 /opt/lanshare-dependencies/runtime.sha256
